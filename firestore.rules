rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isSupervisor() {
      return hasProfile() && userProfile().rol == 'supervisor';
    }

    function userHasAnyRole(roles) {
      return hasProfile() && userProfile().rol in roles;
    }

    function userBelongsToSchool(schoolId) {
      return hasProfile() && userProfile().escuelaId == schoolId;
    }

    function canSeeSchool(schoolId) {
      return isSupervisor() || userBelongsToSchool(schoolId);
    }

    function canSeeSchoolData() {
      return isSupervisor() || (hasProfile() && resource.data.escuelaId == userProfile().escuelaId);
    }

    function onlyChangedFields(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    match /escuelas/{schoolId} {
      allow read: if canSeeSchool(schoolId);
      allow create: if isSupervisor();
      allow update, delete: if isSupervisor();
    }

    match /usuarios/{userId} {
      allow read: if hasProfile() && (userId == request.auth.uid || isSupervisor() || resource.data.escuelaId == userProfile().escuelaId);
      allow create: if isSupervisor();
      allow update: if isSignedIn() && ((request.auth.uid == userId && onlyChangedFields(['nombre', 'email'])) || isSupervisor());
      allow delete: if isSupervisor();
    }

    match /asistencias/{attendanceId} {
      allow read: if canSeeSchoolData();
      allow create: if userHasAnyRole(['director', 'vice', 'preceptor'])
        && request.resource.data.cargadoPor == request.auth.uid
        && userBelongsToSchool(request.resource.data.escuelaId);
      allow update: if isSupervisor() && onlyChangedFields(['verificada', 'verificadoPor', 'verificadoPorNombre', 'verificadoEn']);
      allow delete: if false;
    }

    match /docentes/{docenteId} {
      allow read: if canSeeSchoolData();
      allow create: if isSupervisor();
      allow update, delete: if isSupervisor();
    }

    match /asistencia_docentes/{attendanceId} {
      allow read: if canSeeSchoolData();
      allow create: if userHasAnyRole(['director', 'vice', 'preceptor'])
        && request.resource.data.cargadoPor == request.auth.uid
        && userBelongsToSchool(request.resource.data.escuelaId);
      allow update: if isSupervisor() && onlyChangedFields(['verificada', 'verificadoPor', 'verificadoPorNombre', 'verificadoEn']);
      allow delete: if false;
    }

    match /fotos/{fotoId} {
      allow read: if canSeeSchoolData();
      allow create: if userHasAnyRole(['director', 'vice', 'preceptor'])
        && request.resource.data.subidoPor == request.auth.uid
        && userBelongsToSchool(request.resource.data.escuelaId);
      allow update: if false;
      allow delete: if isSupervisor() || (userBelongsToSchool(resource.data.escuelaId) && request.auth.uid == resource.data.subidoPor);
    }

    match /novedades/{newsId} {
      allow read: if canSeeSchoolData();
      allow create: if userHasAnyRole(['director', 'vice'])
        && request.resource.data.cargadoPor == request.auth.uid
        && userBelongsToSchool(request.resource.data.escuelaId);
      allow update, delete: if false;
    }

    match /incidentes/{incidentId} {
      allow read: if canSeeSchoolData();
      allow create: if userHasAnyRole(['director', 'vice'])
        && request.resource.data.cargadoPor == request.auth.uid
        && userBelongsToSchool(request.resource.data.escuelaId);
      allow update: if isSupervisor() && onlyChangedFields(['estado', 'updatedAt', 'historialEstados']);
      allow delete: if false;
    }

    match /push_tokens/{token} {
      allow read: if isSupervisor() || (hasProfile() && resource.data.userId == request.auth.uid);
      allow create, update: if hasProfile()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token == token;
      allow delete: if hasProfile() && resource.data.userId == request.auth.uid;
    }
  }
}
